{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	request_body {
		max_size 16MB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	@gated {
		not path /health
		not header Cookie *kst_gate={$KST_GATE}*
		not header X-KST-App {$KST_APP_KEY}
	}

	route {
		basic_auth @gated {
			kst $2a$14$B9R9O1iKcGLDo2oLRuTIhOpSYcXL8eXq3LxPv.mPfjNnIXFN1oAkO
		}
		header @gated +Set-Cookie "kst_gate={$KST_GATE}; Path=/; Max-Age=43200; Secure; HttpOnly; SameSite=Strict"
		redir / /web/ 302
		reverse_proxy app:8000
	}
}
